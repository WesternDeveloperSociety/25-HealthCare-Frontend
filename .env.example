# Clerk Authentication
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Backend API URL (include protocol, host, and port — no trailing slash)
# Android Emulator: http://10.0.2.2:5110
# iOS Simulator / Web: http://localhost:5110
# Production: https://api.yourdomain.com
EXPO_PUBLIC_API_URL=http://localhost:5110/api

# Instructions:
# 1. Copy this file to .env
# 2. Replace 'pk_test_your_publishable_key_here' with your actual Clerk publishable key
# 3. Get your key from: https://dashboard.clerk.com/last-active?path=api-keys
# 4. Set EXPO_PUBLIC_API_URL to match your backend (use 10.0.2.2 for Android emulator)